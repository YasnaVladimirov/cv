# Copy to .env.local and fill in. Every value is optional: the site builds and
# runs with all of them missing, and each integration degrades on its own.
# The same values go into Vercel's environment variables for production.

# Form service — Web3Forms. The key is emailed on signup at web3forms.com.
PUBLIC_FORM_ENDPOINT=https://api.web3forms.com/submit
PUBLIC_FORM_KEY=

# Public booking page. The scheme is optional; https:// is added if missing.
PUBLIC_CALENDLY_URL=

# Umami analytics. Without the site id, trackEvent() no-ops silently.
PUBLIC_ANALYTICS_SITE_ID=
PUBLIC_ANALYTICS_HOST=https://cloud.umami.is
