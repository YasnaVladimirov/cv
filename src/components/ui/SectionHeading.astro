---
/**
 * Eyebrow + heading + optional subhead (Design System §7.15).
 *
 * The heading level is a prop rather than fixed at h2 because the same block
 * opens the 404 page, where it is the h1 (§7.22). Sequential heading levels
 * are an accessibility mandate (§10.9), so the level has to follow the page's
 * outline, not the component.
 *
 * The subhead is skipped when the dictionary value is empty in either
 * language — several sections ship with `"subhead": ""` on purpose, and an
 * empty <p> would still contribute its top margin and a line box.
 */
import { hasText } from '../../lib/i18n';
import SectionEyebrow from './SectionEyebrow.astro';
import T from './T.astro';

interface Props {
  eyebrowKey: string;
  titleKey: string;
  subtitleKey?: string;
  /** Follows the page outline. 2 everywhere except the 404 hero. */
  level?: 1 | 2 | 3;
  /** Anchor target for nav and scrollspy — set on the section, not here. */
  id?: string;
  /**
   * REPLACES the heading's size classes; it does not add to them. Appending
   * `text-4xl` to `text-2xl md:text-3xl` would leave two rules setting the
   * same property, and which one wins is decided by Tailwind's stylesheet
   * order rather than by the order they are written — here `md:text-3xl`
   * would quietly undo the override above 768px.
   */
  headingClass?: string;
  class?: string;
}

const {
  eyebrowKey,
  titleKey,
  subtitleKey,
  level = 2,
  id,
  headingClass = 'text-2xl md:text-3xl',
  class: className,
} = Astro.props;

const Heading = `h${level}` as 'h1' | 'h2' | 'h3';
const showSubtitle = subtitleKey !== undefined && hasText(subtitleKey);
---

<div class:list={['mb-8', className]}>
  <SectionEyebrow k={eyebrowKey} class="mb-2" />
  {
    /*
    tabindex="-1" only when the heading is an anchor target: App Flow §7.2
    moves focus here after in-page navigation, so a screen reader user is read
    the heading of the section they just arrived at rather than being left
    where they were. It adds no tab stop — -1 is programmatic focus only.
  */
  }
  <Heading
    id={id}
    tabindex={id ? '-1' : undefined}
    class:list={['text-text-primary', headingClass]}
  >
    <T k={titleKey} />
  </Heading>
  {
    showSubtitle && (
      <p class="mt-2 max-w-prose text-lg text-text-secondary">
        <T k={subtitleKey!} />
      </p>
    )
  }
</div>
