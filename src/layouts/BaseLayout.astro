---
// Base document shell — the one <html> in the project.
//
// Everything structural that is true of every page lives here: the pre-paint
// language script, the token stylesheet, the skip link, the single <main>, and
// the toast host. Pages differ only by what they put in the three slots.
//
// base.css is imported here and nowhere else. Importing it per-component
// would duplicate the @theme block in every chunk.
import '../styles/base.css';
import applyLanguage from '../scripts/apply-language.js?raw';
import { t, DEFAULT_LANG, HTML_LANG } from '../lib/i18n';
import { jsonLd } from '../lib/meta';

/*
 * Font files imported for their hashed URLs so they can be preloaded.
 *
 * Both faces are declared in CSS with `font-display: swap`, so the fallback
 * paints immediately — but the swap to the real face creates a SECOND, later
 * LCP candidate, and that is the one Lighthouse records. Without a preload the
 * browser cannot even discover these until the stylesheet has parsed, so the
 * chain is HTML → CSS → font and the swap lands ~2s in on a throttled mobile
 * connection. Measured in 8.1: render delay was 81% of a 2.25s LCP.
 *
 * Only the Latin subsets are preloaded. Latin-ext carries the Serbian
 * diacritics (š đ č ć ž) but is needed for a minority of glyphs on a minority
 * of visits, and preloading four files to fix two would spend the bandwidth
 * this is trying to save.
 */
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import SkipToContent from '../components/layout/SkipToContent.astro';
import ToastHost from '../components/interactive/Toast';
import ResumeToast from '../components/interactive/ResumeToast';
import Analytics from '../components/interactive/Analytics';

interface Props {
  /** Literal title. Omit and titleKey is used instead. */
  title?: string;
  /** Dictionary key for the title. Metadata is English-only (PRD §5.3). */
  titleKey?: string;
  description?: string;
  descriptionKey?: string;
  /** Overrides the canonical path; defaults to this page's own URL. */
  canonicalPath?: string;
  /** Share image under public/. 1200×630 (PRD §5.3). */
  ogImagePath?: string;
  /** `website` for the home page, `article` for a case study. */
  ogType?: 'website' | 'article';
  /** JSON-LD, serialised into a single ld+json block. */
  structuredData?: Record<string, unknown>;
  /** Keeps dev-only pages (tokens, components) and the 404 out of search results. */
  noindex?: boolean;
  /** Extra classes on <main>. Case-study pages narrow their measure here. */
  mainClass?: string;
}

const {
  title,
  titleKey,
  description,
  descriptionKey,
  canonicalPath,
  ogImagePath = '/og-default.png',
  ogType = 'website',
  structuredData,
  noindex = false,
  mainClass,
} = Astro.props;

// Metadata is deliberately English-only, and no hreflang is emitted: with one
// URL per page there is no Serbian URL for a crawler to point at, so a
// translated title or an alternate link would both be lies (PRD §5.3, FR-6).
const resolvedTitle =
  title ?? (titleKey ? t(titleKey, DEFAULT_LANG) : t('meta.default.title', DEFAULT_LANG));
const resolvedDescription =
  description ??
  (descriptionKey ? t(descriptionKey, DEFAULT_LANG) : t('meta.default.description', DEFAULT_LANG));

// Absolute URLs, which OG and canonical both require. Astro.site comes from
// astro.config.mjs; every absolute URL on the site derives from it, so
// step 7.5 stays a one-line change.
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
const siteName = t('hero.name', DEFAULT_LANG);
---

<html lang={HTML_LANG[DEFAULT_LANG]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {
      /*
      MUST stay above the stylesheet. It sets <html lang> from the stored
      preference so the language-swap CSS is already correct at first paint;
      below the stylesheet, a returning Serbian visitor gets a frame of
      English on every navigation.
    */
    }
    <script is:inline set:html={applyLanguage} />

    {
      /*
      Above the stylesheet, so the fetch starts in parallel with it rather
      than after it. crossorigin is required even for same-origin fonts —
      without it the preload is not matched to the CSS request and the file
      is fetched twice.
    */
    }
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />

    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {
      /*
      Open Graph and Twitter. Case-study links get pasted into Slack threads
      and ATS notes, so how they unfurl is part of the work sample (PRD §5.3).
      og:locale is en_US alone — the Serbian text is injected client-side and
      no crawler or unfurler will ever see it.
    */
    }
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    {
      structuredData && (
        <script type="application/ld+json" set:html={jsonLd(structuredData)} is:inline />
      )
    }
  </head>
  <body>
    <SkipToContent />

    <slot name="header" />

    {
      /*
      One <main> per document, and its id is what the skip link targets
      (§7.24). Pages pass their sections as the default slot rather than
      supplying their own <main>, so that id can never go missing or be
      duplicated.
    */
    }
    <main id="main-content" class:list={['relative z-content', mainClass]}>
      <slot />
    </main>

    <slot name="footer" />
    <slot name="fab" />

    {
      /*
      The toast host is global rather than per-page: the resume CTA that fires
      it appears in the hero, in the 404, and in the footer, and a toast that
      belonged to one section would be unmounted by the time it mattered.
      client:idle — nothing can be toasted before the page is interactive.
    */
    }
    <ToastHost client:idle />
    <ResumeToast client:idle />
    <Analytics client:idle />
  </body>
</html>
