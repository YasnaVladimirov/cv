---
// S2's shell. Header variant B, no FAB, no backdrop shapes.
//
// The omissions are the specification, not an oversight: a case study is a
// text-dense read, and both the floating button and the blurred shapes behind
// it compete with prose for attention (plan §4.2, App Flow §4.9).
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { CALENDLY_URL } from '../lib/calendly';

interface Props {
  title?: string;
  titleKey?: string;
  description?: string;
  descriptionKey?: string;
  canonicalPath?: string;
  ogImagePath?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  /** Defaults to PUBLIC_CALENDLY_URL; §7.19's header CTA opens it in a new tab. */
  calendlyUrl?: string;
}

const {
  title,
  titleKey,
  description,
  descriptionKey,
  canonicalPath,
  ogImagePath,
  ogType,
  structuredData,
  calendlyUrl = CALENDLY_URL,
} = Astro.props;
---

<BaseLayout
  {title}
  {titleKey}
  {description}
  {descriptionKey}
  {canonicalPath}
  {ogImagePath}
  {ogType}
  {structuredData}
>
  <Header slot="header" variant="case-study" calendlyUrl={calendlyUrl} />
  <slot />
  <Footer slot="footer" />
</BaseLayout>
