---
/**
 * Component showcase — every component from Design System §7, every state,
 * side by side (plan §3.0).
 *
 * DEV-ONLY. Not linked from any shipping page, carries noindex, excluded from
 * the sitemap, and deleted in Phase 10.3. Its own chrome is hardcoded English
 * by the same exemption the tokens page carries; the COMPONENTS on it are not
 * exempt — every string they render goes through the dictionary, which is what
 * makes the language toggle at the top a real test.
 *
 * A backdrop shape sits behind the page because glass over plain --color-bg
 * has nothing to blur and looks broken (Design System §3.6).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Case from '../components/dev/Case.astro';
import Section from '../components/dev/Section.astro';
import SectionEyebrow from '../components/ui/SectionEyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import Tag from '../components/ui/Tag.astro';
import AvailabilityBadge from '../components/ui/AvailabilityBadge.astro';
import MetricCallout from '../components/ui/MetricCallout.astro';
import { ArrowRight, ArrowUpRight, X } from '../lib/icons';
import TimelineEntry from '../components/content/TimelineEntry.astro';
import CaseStudyCard from '../components/content/CaseStudyCard.astro';
import TestimonialCard from '../components/content/TestimonialCard.astro';
import { getCollection } from 'astro:content';
import fixtureAvatar from '../content/case-studies/fixture-1.png';
import ToastHost from '../components/interactive/Toast';
import LanguageToggle from '../components/interactive/LanguageToggle';
import StickyFAB from '../components/interactive/StickyFAB';
import ContactForm from '../components/interactive/ContactForm';
import CalendlyEmbed from '../components/interactive/CalendlyEmbed';
import ToastDemo from '../components/dev/ToastDemo';
import FormFieldDemo from '../components/dev/FormFieldDemo';
import FilterPillDemo from '../components/dev/FilterPillDemo';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SkipToContent from '../components/layout/SkipToContent.astro';

// Real fixture content, not hand-written demo data: the showcase has to prove
// these components survive the shapes the schema actually allows — a null end
// date, a role with no case study, a card carrying three metrics.
const roles = (await getCollection('roles')).sort((a, b) => b.data.order - a.data.order);
const caseStudies = (await getCollection('caseStudies'))
  .filter((entry) => entry.data.published)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Components — cv-site" noindex>
  <SkipToContent />

  <main id="main-content" class="z-content relative mx-auto max-w-container p-4 md:p-8">
    <header class="mb-16">
      <p class="font-mono text-mono-sm text-text-tertiary">--components</p>
      <h1 class="text-4xl text-text-primary">Component library</h1>
      <p class="mt-2 max-w-prose text-lg text-text-secondary">
        Every component in Design System §7, in every state. Tab through the page: each interactive
        element must show the focus ring. Switch language: every string must change, with no reload
        and no scroll jump.
      </p>

      <div class="mt-4">
        <LanguageToggle client:load />
      </div>
    </header>

    <Section id="headings" spec="§6.3, §7.15" title="Section eyebrow + heading">
      <Case label="with subhead — the #skills block">
        <SectionHeading
          eyebrowKey="sections.skills.eyebrow"
          titleKey="sections.skills.heading"
          subtitleKey="sections.skills.subhead"
        />
      </Case>

      <Case
        label="no subhead — the dictionary value is an empty string"
        note="The subhead element must be absent, not empty. An empty <p> keeps its 8px top margin and a full line box, so the gap below the heading would silently differ between sections."
      >
        <SectionHeading
          eyebrowKey="sections.work.eyebrow"
          titleKey="sections.work.heading"
          subtitleKey="sections.work.subhead"
        />
      </Case>

      <Case
        label="level 1 — the 404 page"
        note="Same block rendered as h1. Heading level follows the page outline, not the component (§10.9)."
      >
        <SectionHeading
          eyebrowKey="notFound.eyebrow"
          titleKey="notFound.heading"
          subtitleKey="notFound.subtext"
          level={1}
        />
      </Case>

      <Case
        label="eyebrow alone — as used on a case-study card"
        note="Announced to screen readers as nothing: the eyebrow is aria-hidden in every use, because it restates the text beside it."
      >
        <SectionEyebrow k="caseStudy.eyebrow.outcome" />
      </Case>
    </Section>

    <Section id="buttons" spec="§7.1–7.4" title="Button">
      <Case
        label="primary — default · with trailing icon · disabled"
        note="Hover, press and Tab through each one. Primary is the only variant that shifts by 1px on press. A disabled button must not react to hover at all — plain hover: still applies to :disabled in CSS, so every hover rule here is behind enabled:."
      >
        <Button variant="primary" labelKey="hero.cta.book" />
        <Button variant="primary" labelKey="hero.cta.resume" icon={ArrowRight} />
        <Button variant="primary" labelKey="contact.form.submit" disabled />
      </Case>

      <Case label="secondary — default · with icon · disabled">
        <Button variant="secondary" labelKey="hero.cta.book" />
        <Button variant="secondary" labelKey="nav.backToWork" icon={ArrowRight} />
        <Button variant="secondary" labelKey="hero.cta.resume" disabled />
      </Case>

      <Case label="ghost — default · disabled">
        <Button variant="ghost" labelKey="timeline.filter.clear" />
        <Button variant="ghost" labelKey="timeline.filter.clear" disabled />
      </Case>

      <Case
        label="icon-only — 32×32, aria-label required"
        note="The component throws at build time if ariaLabelKey is missing: an icon alone has no accessible name (§7.4), and that is not something to discover in a screen-reader pass."
      >
        <Button variant="icon" icon={X} ariaLabelKey="toast.resumeDownload.dismiss" />
        <Button variant="icon" icon={X} ariaLabelKey="toast.resumeDownload.dismiss" disabled />
      </Case>

      <Case
        label="small — the header CTA (§7.18)"
        note="36px tall, text-sm. Ghost is 36px at both sizes; the spec gives it one box."
      >
        <Button variant="primary" size="small" labelKey="hero.cta.book" />
        <Button variant="secondary" size="small" labelKey="nav.contact" />
      </Case>

      <Case
        label="as a link — href renders an anchor, never a button with role=button"
        note="A thing that navigates is an anchor; §7.1 prohibits patching the wrong element with role=button. The third one carries a Serbian href: switch language and its target moves from /cv.pdf to /cv-sr.pdf. CSS cannot reach an attribute, so that swap is the data-i18n-href pair, not the dual-render."
      >
        <Button variant="secondary" labelKey="nav.work" href="#buttons" />
        <Button
          variant="ghost"
          labelKey="footer.github"
          href="https://github.com"
          target="_blank"
          rel="noopener"
          icon={ArrowUpRight}
        />
        <Button
          variant="primary"
          labelKey="hero.cta.resume"
          href="/cv.pdf"
          hrefSr="/cv-sr.pdf"
          download
          icon={ArrowRight}
        />
      </Case>
    </Section>

    <Section id="links" spec="§7.5" title="Link">
      <Case
        label="inline — inside prose"
        note="Underlined at rest because in a paragraph there is nothing else marking it. The underline is accent-coloured, the text is not; on hover the text catches up."
      >
        <p class="max-w-prose text-base text-text-primary">
          A sentence with <Link href="#links">an inline link</Link> in the middle of it, so the underline
          offset can be judged against a real line of text.
        </p>
      </Case>

      <Case label="standalone — the card and timeline link">
        <Link variant="standalone" href="#links" labelKey="timeline.readCaseStudy" />
      </Case>

      <Case
        label="external — new tab, arrow-up-right"
        note="target=_blank with rel=noopener. The arrow differs from standalone on purpose: it is the only signal that the link leaves the site."
      >
        <Link variant="external" href="https://github.com" labelKey="footer.github" />
        <Link variant="external" href="https://linkedin.com" labelKey="footer.linkedin" />
      </Case>

      <Case
        label="all three, focused"
        note="Tab through these. The ring appears and the underline must NOT change — a moving underline reads as a second, competing focus indicator."
      >
        <Link href="#links" labelKey="nav.contact" />
        <Link variant="standalone" href="#links" labelKey="nav.work" />
        <Link variant="external" href="https://example.com" labelKey="footer.email" />
      </Case>
    </Section>

    <Section id="tags" spec="§7.12" title="Tag">
      <Case label="stack tag — non-interactive, renders as a span">
        <Tag label="React" />
        <Tag label="TypeScript" />
        <Tag label="Astro" />
      </Case>

      <Case
        label="interactive skill — default · active (filter applied)"
        note="Hover the first: border, background and text all move to accent together. The second is the filter-applied state, carrying aria-pressed=true."
      >
        <Tag label="React" interactive />
        <Tag label="TypeScript" interactive active />
      </Case>

      <Case
        label="skill with no timeline matches — falls back to the static style"
        note="This is the one that matters. A skill whose timeline_matches is empty renders as a span, not a button: unfocusable, no hover, nothing to click. That is what makes the zero-result filter state in App Flow §4.6 unreachable rather than just unlikely — Tab through this row and only two of the three stop."
      >
        <Tag label="React" interactive matches />
        <Tag label="Figma" interactive matches={false} />
        <Tag label="Astro" interactive matches />
      </Case>
    </Section>

    <Section id="availability" spec="§7.13" title="Availability badge">
      <Case
        label="enabled"
        note="Watch the dot: a 2s opacity loop, the only looping animation in the system. Turn on Reduce Motion in system settings and it must stop dead, not merely speed up — the global rule sets iteration-count to 1."
      >
        <AvailabilityBadge enabled />
      </Case>

      <Case
        label="disabled — the launch state"
        note="hero.availability.enabled is false in the dictionary, so the component renders nothing at all. There should be an empty row below this line."
      >
        <AvailabilityBadge />
      </Case>
    </Section>

    <Section id="metrics" spec="§6.4" title="Metric callout">
      <Case
        label="a row of three, as on a case-study card"
        note="tabular-nums: the digits sit on a common grid, so the three values line up regardless of which numerals they use. Every one carries a unit and a direction — §6.4 forbids this treatment for anything that is not a measured outcome."
      >
        <div class="flex flex-wrap gap-8">
          <MetricCallout value="-58%" labelEn="LCP on mobile" labelSr="LCP na mobilnom" />
          <MetricCallout value="+6.2%" labelEn="Checkout conversion" labelSr="Konverzija naplate" />
          <MetricCallout value="200k" labelEn="Monthly users" labelSr="Mesečnih korisnika" />
        </div>
      </Case>
    </Section>

    <Section id="timeline" spec="§7.14" title="Timeline entry">
      <Case
        label="unfiltered — four fixture roles"
        wide
        note="The first has end: null and reads as Present, translated. Dates go through Intl, never a template: switch language and the month abbreviation changes with it. The fourth role has no case study, so no link renders — that is content deciding, not a prop."
      >
        <div class="w-full">
          {
            roles.map((role) => (
              <TimelineEntry
                role={role.data}
                caseStudyHref={
                  role.data.case_study ? `/work/${role.data.case_study.id}` : undefined
                }
              />
            ))
          }
        </div>
      </Case>

      <Case
        label="filtered — one match, one dimmed"
        wide
        note="What a skill filter looks like once Phase 5 wires it. The match gains a 2px accent edge and indents to meet it; the non-match drops to 0.35 opacity. Both come from one data attribute, so applying a filter is a single write per entry."
      >
        <div class="w-full">
          <TimelineEntry role={roles[0].data} filter="match" />
          <TimelineEntry role={roles[1].data} filter="out" />
        </div>
      </Case>
    </Section>

    <Section id="case-study-cards" spec="§7.10" title="Case study card">
      <Case
        label="spotlight — one published study, the probable launch state"
        wide
        note="Horizontal from md up, 4:3 image. The whole card is a single anchor and therefore a single tab stop: Tab into it once and the next Tab leaves it. The Read case study line is a span for exactly that reason."
      >
        <div class="w-full">
          <CaseStudyCard
            layout="spotlight"
            href={`/work/${caseStudies[0].id}`}
            title_en={caseStudies[0].data.title_en}
            title_sr={caseStudies[0].data.title_sr}
            outcome_en={caseStudies[0].data.outcome_en}
            outcome_sr={caseStudies[0].data.outcome_sr}
            metrics={caseStudies[0].data.metrics}
            stack={caseStudies[0].data.stack}
            image={caseStudies[0].data.hero_image}
            imageAlt_en={caseStudies[0].data.hero_image_alt_en}
            imageAlt_sr={caseStudies[0].data.hero_image_alt_sr}
          />
        </div>
      </Case>

      <Case
        label="grid — three up"
        wide
        note="Same component, 16:10 image, min-height 420px so the row stays even. Switch language and it becomes 460px: Serbian runs about 35% longer, and without that the tallest card drags the whole row on every toggle."
      >
        <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-3">
          {
            caseStudies.map((entry) => (
              <CaseStudyCard
                href={`/work/${entry.id}`}
                title_en={entry.data.title_en}
                title_sr={entry.data.title_sr}
                outcome_en={entry.data.outcome_en}
                outcome_sr={entry.data.outcome_sr}
                metrics={entry.data.metrics}
                stack={entry.data.stack}
                image={entry.data.hero_image}
                imageAlt_en={entry.data.hero_image_alt_en}
                imageAlt_sr={entry.data.hero_image_alt_sr}
              />
            ))
          }
        </div>
      </Case>
    </Section>

    <Section id="testimonials" spec="§7.11" title="Testimonial card">
      <Case
        label="one card — fed a fixture, since the collection is empty"
        wide
        note="Not glass, on purpose: this is the densest block of read-once text on the page and §10.1 wants the contrast. Solid surface, 1px border, no shadow. Nothing renders this at launch; it exists so that turning testimonials on later is a content change."
      >
        <div class="w-full max-w-prose">
          <TestimonialCard
            quote_en="FIXTURE — He rebuilt the checkout flow in six weeks and it has not needed a hotfix since. What I remember is that he found the problem we actually had, not the one we described."
            quote_sr="FIXTURE — Prepravio je tok naplate za šest nedelja i od tada nije bilo nijedne hitne popravke. Pamtim to što je pronašao pravi problem, a ne onaj koji smo opisali."
            author="FIXTURE Jane Doe"
            role_en="FIXTURE Engineering Manager"
            role_sr="FIXTURE Menadžer inženjeringa"
            company="FIXTURE Globex"
            avatar={fixtureAvatar}
            linkedinUrl="https://linkedin.com"
          />
        </div>
      </Case>
    </Section>

    <Section id="form-primitives" spec="§7.7–7.9" title="Form primitives">
      <Case
        label="default · with helper · error · disabled · textarea"
        wide
        note="Every control sits inside a FormField, which owns the for/id pairing, aria-describedby and aria-invalid. Click a label: focus must land in its control — that is the pairing working. The error field keeps its helper text, because dropping instructions the moment something goes wrong removes them exactly when they are needed. Drag the textarea's corner: it grows down to 320px and refuses to grow sideways."
      >
        <FormFieldDemo client:load />
      </Case>
    </Section>

    <Section id="toast" spec="§7.6" title="Toast">
      <Case
        label="trigger — then leave it, hover it, and press Escape"
        note="Three things to check. It auto-dismisses after 3s. Hovering pauses that timer, and so does tabbing to the close button — hover alone would let it vanish under a keyboard user's hands. Triggering again while one is visible replaces it and replays the entry; toasts never stack."
      >
        <ToastDemo client:load />
      </Case>
    </Section>

    <Section id="language-toggle" spec="§7.16" title="Language toggle">
      <Case
        label="the real control — the same one now mounted in this page's header"
        note="One button, not a dropdown. Both labels stay visible so the control never changes width under the pointer. aria-label names the action, not the state, because aria-pressed already carries the state."
      >
        <LanguageToggle client:load />
      </Case>
    </Section>

    <Section id="fab" spec="§7.17" title="Sticky contact FAB">
      <Case
        label="hidden while #hero or #contact is in view, and while typing"
        wide
        note="Scroll: the button appears once the fake hero leaves and disappears when the fake contact block arrives. Then click into the field below and it hides — on a phone a 48px button pinned 16px from the bottom sits exactly where the keyboard pushes the focused input."
      >
        <div class="w-full">
          <div id="hero" class="mb-4 rounded-md border border-border-subtle bg-bg-elevated p-8">
            <p class="text-sm text-text-secondary">#hero — FAB hidden while this is on screen</p>
          </div>
          <div class="my-8 flex flex-col gap-4">
            <p class="text-sm text-text-secondary">
              Scroll region. The FAB is visible through here.
            </p>
            <input
              type="text"
              aria-label="Focus me to hide the FAB"
              placeholder="Focus me — the FAB should hide"
              class="h-[44px] w-full max-w-prose rounded-sm border border-border bg-bg-elevated px-3 text-base"
            />
          </div>
          <div id="contact" class="mt-4 rounded-md border border-border-subtle bg-bg-elevated p-8">
            <p class="text-sm text-text-secondary">#contact — FAB hidden while this is on screen</p>
          </div>
        </div>
        <StickyFAB client:load />
      </Case>
    </Section>

    <Section id="filter-pill" spec="§7.21" title="Filter pill">
      <Case
        label="active — the close button clears it"
        note="Sticky within #work only, never to the viewport: the pill answers why the list is short, so it should not follow the reader past the list it is describing. Its close button names the skill — read out of context, Clear filter leaves a screen reader user to remember which one."
      >
        <FilterPillDemo client:load />
      </Case>
    </Section>

    <Section id="contact-form" spec="§7.9, App Flow §4.7" title="Contact form">
      <Case
        label="submit empty — validation runs on submit, never on blur"
        wide
        note="Press Send with everything empty. Errors appear, focus moves to the summary so it is announced, and the first broken field is one Tab away. Now fix them one at a time: nothing re-validates until you submit again, because telling someone their email is wrong while they are still typing it is how a short form turns hostile. Add ?form=error to the URL for the endpoint-failure state, which hands back a mailto rather than apologising."
      >
        <div class="w-full max-w-prose">
          <ContactForm client:load email="hello@example.com" />
        </div>
      </Case>
    </Section>

    <Section id="calendly" spec="§7.23" title="Calendly placeholder">
      <Case
        label="loading — and the same panel after the 4s timeout"
        wide
        note="Full-size, not a spinner: it reserves the embed's eventual height so the page does not reflow when the widget lands, and it is the only skeleton §2 permits. Wait 4s on the left panel and it becomes the right one on its own — a blocked widget is the likeliest outcome on this page, not an edge case."
      >
        <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-2">
          <CalendlyEmbed client:load directUrl="https://calendly.com" />
          <CalendlyEmbed client:load forceState="failed" directUrl="https://calendly.com" />
        </div>
      </Case>
    </Section>

    <Section id="headers" spec="§7.18–7.19" title="Header variants">
      <Case
        label="variant A — home, with the Work anchor active"
        wide
        note="Sticky, glass, 64px on mobile and 72px from md. The centre nav is desktop-only and there is no hamburger at any width: with three anchors a menu hides three links behind a tap. Narrow the window past 768px and the primary CTA is replaced by a secondary Contact, so the row never shows two competing primaries at 320px."
      >
        <div class="w-full overflow-hidden rounded-md border border-border-subtle">
          <Header variant="home" activeSection="work" />
          <div class="h-32 bg-bg"></div>
        </div>
      </Case>

      <Case
        label="variant B — case study, with a back-link"
        wide
        note="Same shell, different centre. Its CTA opens Calendly in a new tab rather than scrolling to a contact section this page does not have."
      >
        <div class="w-full overflow-hidden rounded-md border border-border-subtle">
          <Header variant="case-study" calendlyUrl="https://calendly.com" />
          <div class="h-32 bg-bg"></div>
        </div>
      </Case>

      <Case
        label="variant B — 404, centre deliberately empty"
        wide
        note="No back-link. §7.19 leaves it out because a 404 has no work page the visitor was coming from, and pointing back to one implies they took a wrong turn from somewhere they never were."
      >
        <div class="w-full overflow-hidden rounded-md border border-border-subtle">
          <Header variant="not-found" />
          <div class="h-32 bg-bg"></div>
        </div>
      </Case>
    </Section>

    <Section id="skip-link" spec="§7.24" title="Skip to content">
      <Case
        label="the first tab stop on this page"
        note="Click the page background, then press Tab once. It appears at the top left. It is moved off-screen rather than hidden, because display:none and visibility:hidden both remove an element from the tab order — the link could never be focused and would never appear."
      >
        <p class="text-sm text-text-secondary">
          Already mounted above &lt;main&gt;. Press Tab from the top of the page.
        </p>
      </Case>
    </Section>
  </main>

  <Footer />

  <ToastHost client:load />
</BaseLayout>
