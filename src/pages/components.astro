---
/**
 * Component showcase — every component from Design System §7, every state,
 * side by side (plan §3.0).
 *
 * DEV-ONLY. Not linked from any shipping page, carries noindex, excluded from
 * the sitemap, and deleted in Phase 10.3. Its own chrome is hardcoded English
 * by the same exemption the tokens page carries; the COMPONENTS on it are not
 * exempt — every string they render goes through the dictionary, which is what
 * makes the language toggle at the top a real test.
 *
 * A backdrop shape sits behind the page because glass over plain --color-bg
 * has nothing to blur and looks broken (Design System §3.6).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Case from '../components/dev/Case.astro';
import Section from '../components/dev/Section.astro';
import SectionEyebrow from '../components/ui/SectionEyebrow.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import Link from '../components/ui/Link.astro';
import { ArrowRight, ArrowUpRight, X } from '../lib/icons';
---

<BaseLayout title="Components — cv-site" noindex>
  <main id="main-content" class="relative mx-auto max-w-container p-4 md:p-8">
    <header class="mb-16">
      <p class="font-mono text-mono-sm text-text-tertiary">--components</p>
      <h1 class="text-4xl text-text-primary">Component library</h1>
      <p class="mt-2 max-w-prose text-lg text-text-secondary">
        Every component in Design System §7, in every state. Tab through the page: each interactive
        element must show the focus ring. Switch language: every string must change, with no reload
        and no scroll jump.
      </p>

      {
        /*
        Stand-in for the real LanguageToggle, which arrives in step 3.12. Without
        it, steps 3.1-3.11 could only be reviewed in English, and half the point
        of this page is catching where a ~35% longer SR string overflows a
        component. It sets <html lang> and nothing else, which is exactly what the
        language CSS keys on. Replaced by the real component in 3.12.
      */
      }
      <button
        id="dev-lang"
        type="button"
        class="mt-4 h-[36px] rounded-md border border-border bg-bg-elevated px-4 font-mono text-mono-sm text-text-primary"
      >
        dev: toggle language
      </button>
      <script is:inline>
        document.getElementById('dev-lang').addEventListener('click', () => {
          const root = document.documentElement;
          root.lang = root.lang.startsWith('sr') ? 'en' : 'sr-Latn';
        });
      </script>
    </header>

    <Section id="headings" spec="§6.3, §7.15" title="Section eyebrow + heading">
      <Case label="with subhead — the #skills block">
        <SectionHeading
          eyebrowKey="sections.skills.eyebrow"
          titleKey="sections.skills.heading"
          subtitleKey="sections.skills.subhead"
        />
      </Case>

      <Case
        label="no subhead — the dictionary value is an empty string"
        note="The subhead element must be absent, not empty. An empty <p> keeps its 8px top margin and a full line box, so the gap below the heading would silently differ between sections."
      >
        <SectionHeading
          eyebrowKey="sections.work.eyebrow"
          titleKey="sections.work.heading"
          subtitleKey="sections.work.subhead"
        />
      </Case>

      <Case
        label="level 1 — the 404 page"
        note="Same block rendered as h1. Heading level follows the page outline, not the component (§10.9)."
      >
        <SectionHeading
          eyebrowKey="notFound.eyebrow"
          titleKey="notFound.heading"
          subtitleKey="notFound.subtext"
          level={1}
        />
      </Case>

      <Case
        label="eyebrow alone — as used on a case-study card"
        note="Announced to screen readers as nothing: the eyebrow is aria-hidden in every use, because it restates the text beside it."
      >
        <SectionEyebrow k="caseStudy.eyebrow.outcome" />
      </Case>
    </Section>

    <Section id="buttons" spec="§7.1–7.4" title="Button">
      <Case
        label="primary — default · with trailing icon · disabled"
        note="Hover, press and Tab through each one. Primary is the only variant that shifts by 1px on press. A disabled button must not react to hover at all — plain hover: still applies to :disabled in CSS, so every hover rule here is behind enabled:."
      >
        <Button variant="primary" labelKey="hero.cta.book" />
        <Button variant="primary" labelKey="hero.cta.resume" icon={ArrowRight} />
        <Button variant="primary" labelKey="contact.form.submit" disabled />
      </Case>

      <Case label="secondary — default · with icon · disabled">
        <Button variant="secondary" labelKey="hero.cta.book" />
        <Button variant="secondary" labelKey="nav.backToWork" icon={ArrowRight} />
        <Button variant="secondary" labelKey="hero.cta.resume" disabled />
      </Case>

      <Case label="ghost — default · disabled">
        <Button variant="ghost" labelKey="timeline.filter.clear" />
        <Button variant="ghost" labelKey="timeline.filter.clear" disabled />
      </Case>

      <Case
        label="icon-only — 32×32, aria-label required"
        note="The component throws at build time if ariaLabelKey is missing: an icon alone has no accessible name (§7.4), and that is not something to discover in a screen-reader pass."
      >
        <Button variant="icon" icon={X} ariaLabelKey="toast.resumeDownload.dismiss" />
        <Button variant="icon" icon={X} ariaLabelKey="toast.resumeDownload.dismiss" disabled />
      </Case>

      <Case
        label="small — the header CTA (§7.18)"
        note="36px tall, text-sm. Ghost is 36px at both sizes; the spec gives it one box."
      >
        <Button variant="primary" size="small" labelKey="hero.cta.book" />
        <Button variant="secondary" size="small" labelKey="nav.contact" />
      </Case>

      <Case
        label="as a link — href renders an anchor, never a button with role=button"
        note="A thing that navigates is an anchor; §7.1 prohibits patching the wrong element with role=button. The third one carries a Serbian href: switch language and its target moves from /cv.pdf to /cv-sr.pdf. CSS cannot reach an attribute, so that swap is the data-i18n-href pair, not the dual-render."
      >
        <Button variant="secondary" labelKey="nav.work" href="#buttons" />
        <Button
          variant="ghost"
          labelKey="footer.github"
          href="https://github.com"
          target="_blank"
          rel="noopener"
          icon={ArrowUpRight}
        />
        <Button
          variant="primary"
          labelKey="hero.cta.resume"
          href="/cv.pdf"
          hrefSr="/cv-sr.pdf"
          download
          icon={ArrowRight}
        />
      </Case>
    </Section>

    <Section id="links" spec="§7.5" title="Link">
      <Case
        label="inline — inside prose"
        note="Underlined at rest because in a paragraph there is nothing else marking it. The underline is accent-coloured, the text is not; on hover the text catches up."
      >
        <p class="max-w-prose text-base text-text-primary">
          A sentence with <Link href="#links">an inline link</Link> in the middle of it, so the underline
          offset can be judged against a real line of text.
        </p>
      </Case>

      <Case label="standalone — the card and timeline link">
        <Link variant="standalone" href="#links" labelKey="timeline.readCaseStudy" />
      </Case>

      <Case
        label="external — new tab, arrow-up-right"
        note="target=_blank with rel=noopener. The arrow differs from standalone on purpose: it is the only signal that the link leaves the site."
      >
        <Link variant="external" href="https://github.com" labelKey="footer.github" />
        <Link variant="external" href="https://linkedin.com" labelKey="footer.linkedin" />
      </Case>

      <Case
        label="all three, focused"
        note="Tab through these. The ring appears and the underline must NOT change — a moving underline reads as a second, competing focus indicator."
      >
        <Link href="#links" labelKey="nav.contact" />
        <Link variant="standalone" href="#links" labelKey="nav.work" />
        <Link variant="external" href="https://example.com" labelKey="footer.email" />
      </Case>
    </Section>
  </main>
</BaseLayout>
