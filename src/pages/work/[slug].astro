---
/**
 * S2 — the case study page (App Flow §4.9, plan §4.5).
 *
 * One prerendered route per PUBLISHED case study. An unpublished study
 * generates no route, so a request for it falls through to the 404 — which is
 * the same server-rendered S3 a mistyped slug gets, with no client-side
 * redirect flicker.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseStudyHeading from '../../components/content/CaseStudyHeading.astro';
import SectionEyebrow from '../../components/ui/SectionEyebrow.astro';
import MetricCallout from '../../components/ui/MetricCallout.astro';
import Button from '../../components/ui/Button.astro';
import Link from '../../components/ui/Link.astro';
import Tag from '../../components/ui/Tag.astro';
import T from '../../components/ui/T.astro';
import TContent from '../../components/ui/TContent.astro';
import { t, DEFAULT_LANG } from '../../lib/i18n';

export async function getStaticPaths() {
  const studies = (await getCollection('caseStudies', ({ data }) => data.published)).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return studies.map((study, index) => ({
    params: { slug: study.id },
    props: {
      study,
      // Sequence comes from the frontmatter `order`, not from the filesystem.
      previous: studies[index - 1],
      next: studies[index + 1],
      total: studies.length,
    },
  }));
}

type Props = {
  study: Awaited<ReturnType<typeof getCollection<'caseStudies'>>>[number];
  previous?: Awaited<ReturnType<typeof getCollection<'caseStudies'>>>[number];
  next?: Awaited<ReturnType<typeof getCollection<'caseStudies'>>>[number];
  total: number;
};

const { study, previous, next, total } = Astro.props;
const { Content } = await render(study);

// TODO(human): Phase 6 — replace with PUBLIC_CALENDLY_URL from the environment.
const calendlyUrl = '#';
---

<CaseStudyLayout title={study.data.title_en} description={study.data.outcome_en}>
  <article id={study.id} class="mx-auto max-w-container px-4 py-24 sm:px-6 md:px-8 md:py-32">
    <header class="max-w-prose">
      <SectionEyebrow k="caseStudy.eyebrow.card" class="mb-2" />
      <h1 class="text-4xl break-words text-text-primary">
        <TContent en={study.data.title_en} sr={study.data.title_sr} />
      </h1>
      <p class="mt-4 text-lg text-text-secondary">
        <TContent en={study.data.outcome_en} sr={study.data.outcome_sr} />
      </p>

      {
        /*
        The at-a-glance strip §6.4 allows: the frontmatter metrics and stack,
        read before the prose rather than after it. They carry no heading of
        their own because the body already has labelled Outcome and Stack
        sections, and a second "Outcome" over the same three numbers would be
        the page saying it twice.
      */
      }
      <div class="mt-8 flex flex-col gap-8 sm:flex-row sm:flex-wrap">
        {
          study.data.metrics.map((metric) => (
            <MetricCallout
              value={metric.value}
              labelEn={metric.label_en}
              labelSr={metric.label_sr}
            />
          ))
        }
      </div>

      <div class="mt-8 flex flex-wrap gap-2">
        {study.data.stack.map((item) => <Tag label={item} />)}
      </div>
    </header>

    {
      /*
      Explicit dimensions come from the imported asset, so the space is
      reserved before the file arrives and the page never shifts (§4.9).
      The alt text is an attribute, hence the data-i18n pair rather than two
      images — one <img>, two possible alt strings.
    */
    }
    <Image
      src={study.data.hero_image}
      alt={study.data.hero_image_alt_en}
      data-i18n-alt-en={study.data.hero_image_alt_en}
      data-i18n-alt-sr={study.data.hero_image_alt_sr}
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 1024px, 100vw"
      class="mt-12 w-full rounded-md"
      loading="eager"
    />

    <div class="case-study-body mt-12 max-w-prose">
      <Content components={{ h2: CaseStudyHeading }} />
    </div>

    {
      /*
      The bottom CTA goes straight to the calendar in a new tab rather than to
      #contact: the reader is at the end of an article on a page that has no
      contact section of its own (§4.9).
    */
    }
    <section class="glass mt-24 flex flex-col items-start gap-4 p-8 md:mt-32">
      <h2 class="text-2xl text-text-primary md:text-3xl">
        <T k="caseStudy.cta.heading" />
      </h2>
      <Button
        variant="primary"
        labelKey="caseStudy.cta.book"
        href={calendlyUrl}
        target="_blank"
        rel="noopener"
      />
    </section>

    {
      /*
      Hidden entirely when there is one study — disabled arrows would be a
      dead end advertised as navigation (§4.9).
    */
    }
    {
      total > 1 && (
        <nav
          class="mt-12 flex flex-wrap justify-between gap-4 border-t border-border-subtle pt-8"
          aria-label={t('sections.caseStudies.heading', DEFAULT_LANG)}
          data-i18n-aria-label-en={t('sections.caseStudies.heading', 'en')}
          data-i18n-aria-label-sr={t('sections.caseStudies.heading', 'sr')}
        >
          {/* `inline`, not `standalone`: the standalone variant carries a
              forward arrow, and pointing it at "Previous" is a lie about
              direction. Neither icons barrel carries a back arrow, and adding
              one for two links is not worth the weight. */}
          <div>
            {previous && (
              <Link
                variant="inline"
                href={`/work/${previous.id}`}
                labelKey="caseStudy.nav.previous"
              />
            )}
          </div>
          <div>
            {next && (
              <Link variant="inline" href={`/work/${next.id}`} labelKey="caseStudy.nav.next" />
            )}
          </div>
        </nav>
      )
    }
  </article>
</CaseStudyLayout>

<style>
  /* The MDX body is authored markdown, so its elements carry no classes.
     Scoped to .case-study-body and reaching into rendered children, which is
     what :global is for here — these rules must not leak to the rest of S2. */
  .case-study-body :global(p) {
    margin-top: var(--spacing-4);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-text-primary);
  }

  .case-study-body :global(ul),
  .case-study-body :global(ol) {
    margin-top: var(--spacing-4);
    padding-left: var(--spacing-6);
    /* Longhand, not the `list-style` shorthand: the CSS minifier rewrites
       `list-style: disc` to `list-style: outside`, betting that `disc` is the
       initial value anyway. It is — but Tailwind's preflight sets
       `list-style: none` on every ul, so the shorthand has to reinstate the
       type explicitly and a rewritten shorthand only happens to work. */
    list-style-type: disc;
  }

  .case-study-body :global(li) {
    margin-top: var(--spacing-2);
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
  }

  .case-study-body :global(a) {
    color: var(--color-text-primary);
    text-decoration-color: var(--color-accent);
    text-underline-offset: 3px;
  }
</style>
