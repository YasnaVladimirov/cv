{
  "name": "cv-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run --passWithNoTests",
    "lint": "prettier --check .",
    "verify:theme": "node scripts/verify-theme.mjs",
    "verify:fonts": "node scripts/verify-fonts.mjs",
    "verify:i18n": "node scripts/verify-i18n-parity.mjs",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:gradients": "node scripts/verify-no-gradients.mjs",
    "verify:values": "node scripts/verify-no-raw-values.mjs",
    "verify:css": "node scripts/verify-css-output.mjs",
    "verify:no-flash": "node scripts/verify-no-flash.mjs",
    "verify:metadata": "node scripts/verify-metadata.mjs",
    "verify:source": "pnpm lint && pnpm verify:values && pnpm verify:gradients && pnpm verify:i18n && pnpm verify:content",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "format": "prettier --write .",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.8",
    "@astrojs/mdx": "7.0.8",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@lucide/astro": "1.34.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.6",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "fontkit": "2.0.4",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "sharp": "0.35.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
